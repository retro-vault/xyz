	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=11, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-11(ix), l
	ld	-10(ix), h
	ld	h, d
	ld	l, e
	ld	-9(ix), l
	ld	-8(ix), h
	ld	hl, #-11
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	ld	l, -11(ix)
	ld	h, -10(ix)
	ld	a, l
	and	#7
	ld	l, a
	ld	a, h
	and	#0
	ld	h, a
	ld	-7(ix), l
	ld	-6(ix), h
	ex	de, hl
	ld	hl, #3
	or	a, a
	sbc	hl, de
	jr	z, __xcc_L0
	ld	l, -7(ix)
	ld	h, -6(ix)
	ex	de, hl
	ld	hl, #5
	or	a, a
	sbc	hl, de
	jr	z, __xcc_L1
	jr	__xcc_L2
__xcc_L0:
	call	__xopt_spaghetti_0
	jr	z, __xcc_L5
__xcc_L4:
	ld	hl, #43
	ld	-5(ix), l
	ld	-4(ix), h
	jr	__xcc_L6
__xcc_L5:
	ld	hl, #45
	ld	-5(ix), l
	ld	-4(ix), h
__xcc_L6:
	ld	l, -5(ix)
	ld	h, -4(ix)
	ld	a, l
	ld	-3(ix), a
	jr	__xcc_L3
__xcc_L1:
	call	__xopt_spaghetti_0
	jr	z, __xcc_L8
__xcc_L7:
	ld	hl, #101
	ld	-2(ix), l
	ld	-1(ix), h
	jr	__xcc_L9
__xcc_L8:
	ld	hl, #69
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L9:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, l
	ld	-3(ix), a
	jr	__xcc_L3
__xcc_L2:
	ld	a, #32
	ld	-3(ix), a
__xcc_L3:
	ld	a, -3(ix)
	ld	l, a
	rlca
	sbc	a, a
	ld	h, a
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
	; xopt: spaghetti outlined duplicate kernel
	.area	_CODE
__xopt_spaghetti_0:
	ld	l, -9(ix)
	ld	h, -8(ix)
	ld	a, l
	and	#1
	ld	l, a
	ld	a, h
	and	#0
	ld	h, a
	ld	b, h
	ld	c, l
	ld	a, h
	or	a, l
	ret
