	.module	xcc_output
	.area	_CODE
	.globl	_dragon_pair
_dragon_pair:
	; sdcccall(1) prologue: dragon_pair (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	res	0, l
	res	0, e
	res	0, c
	set	0, l
	set	0, e
	set	0, c
__dragon_pair_end:
	; epilogue: dragon_pair
	ld	sp, ix
	pop	ix
	ret
