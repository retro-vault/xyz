	.module	xcc_output
	.area	_CODE
	.globl	_ret_global
_ret_global:
	; sdcccall(1) prologue: ret_global (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	h, d
	ld	l, e
	ld	a, l
	xor	#85
	ld	l, a
	ld	a, #3
	ld	e, a
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ex	de, hl
__ret_global_end:
	; epilogue: ret_global
	ret
