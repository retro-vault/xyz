	.module	xcc_output
	.area	_DATA
_sink:
	.ds	2
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	b, h
	ld	c, l
	ld	h, b
	ld	l, c
	ld	a, h
	or	a, l
	jr	z, b
a:
	ld	hl, #5
	ld	(_sink), hl
	jr	done
b:
	ld	hl, #5
	ld	(_sink), hl
done:
	ld	hl, (_sink)
	inc	hl
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ret
