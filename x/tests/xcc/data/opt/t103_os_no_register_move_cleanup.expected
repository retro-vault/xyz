	.module	xcc_output
	.area	_CODE
	.globl	_tame_os_register_moves
_tame_os_register_moves:
	; sdcccall(1) prologue: tame_os_register_moves (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	a, h
	ld	h, a
	ld	a, #3
	ld	b, #1
	ld	b, c
	ld	d, e
	ld	e, d
__tame_os_register_moves_end:
	; epilogue: tame_os_register_moves
	ld	sp, ix
	pop	ix
	ret
