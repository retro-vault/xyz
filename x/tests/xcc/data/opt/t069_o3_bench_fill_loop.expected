	.module	xcc_output
	.area	_DATA
_buf:
	.ds	16
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=7, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-7
	add	hl, sp
	ld	sp, hl
	; O3 bench-fill loop (count=16)
	ld	a, #7
	ld	c, a
	ld	b, #0
	ld	hl, #buf
__xcc_L0:
	ld	a, b
	cp	#16
	jr	nc, __xcc_L3
__xcc_L1:
	ld	a, c
	add	a, a
	add	a, a
	add	a, a
	xor	c
	ld	d, a
	rlca
	rlca
	rlca
	and	#7
	xor	d
	add	a, #29
	add	a, b
	ld	c, a
	xor	b
	ld	(hl), a
	inc	b
	inc	hl
	jr	__xcc_L0
__xcc_L3:
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
