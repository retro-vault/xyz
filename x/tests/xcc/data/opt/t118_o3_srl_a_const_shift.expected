	.module	xcc_output
	.area	_CODE
	.globl	_dragon_srl_a
_dragon_srl_a:
	; sdcccall(1) prologue: dragon_srl_a (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	rlca
	rlca
	rlca
	and	#7
	xor	d
	rlca
	rlca
	rlca
	and	#1
__dragon_srl_a_end:
	; epilogue: dragon_srl_a
	ld	sp, ix
	pop	ix
	ret
