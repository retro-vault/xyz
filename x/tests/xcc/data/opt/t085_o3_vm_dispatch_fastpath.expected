	.module	xcc_output
	.area	_DATA
_main__code_0:
	.ds	96
_main__mem_1:
	.ds	16
	.area	_CODE
_bench_seed_byte:
	; O3 sdcc-style leaf fast path: byte seed helper
	ld	c, a
	ld	hl, (#65296)
	ld	a, l
	xor	a, c
	ld	l, a
	ld	e, l
	ld	d, h
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, l
	xor	a, e
	ld	e, a
	ld	a, h
	xor	a, d
	ld	d, a
	rlca
	rlca
	rlca
	and	#248
	ld	l, a
	ld	a, e
	rlca
	rlca
	rlca
	and	#7
	or	l
	xor	e
	ld	e, a
	ld	a, d
	rlca
	rlca
	rlca
	and	#7
	ld	l, a
	xor	d
	ld	d, a
	ld	b, #0
	ld	hl, #49
	add	hl, bc
	add	hl, de
	ld	a, l
	ret
_bench_mix16:
	; O3 sdcc-style leaf fast path: two-arg word mix helper
	ld	c, l
	ld	b, h
	ld	hl, #40503
	add	hl, de
	ld	a, c
	xor	l
	ld	l, a
	ld	a, b
	xor	h
	ld	b, a
	ld	h, a
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, b
	rrca
	rrca
	rrca
	and	#31
	or	l
	ld	l, a
	ld	a, e
	xor	#74
	ld	c, a
	ld	a, d
	xor	#127
	ld	b, a
	add	hl, bc
	ex	de, hl
	ret
	.globl	_main
_main:
	; O3 vm-dispatch benchmark fast path
	ld	a, #6
	call	_bench_seed_byte
	ld	c, a
	ld	b, #0
	ld	hl, #_main__code_0
__xcc_vm_fill_code:
	ld	a, b
	cp	#96
	jr	nc, __xcc_vm_fill_code_end
	call	__xopt_spaghetti_2
	add	a, #109
	add	a, b
	ld	c, a
	xor	b
	ld	(hl), a
	inc	b
	inc	hl
	jr	__xcc_vm_fill_code
__xcc_vm_fill_code_end:
	ld	a, #55
	call	_bench_seed_byte
	ld	c, a
	ld	b, #0
	ld	hl, #_main__mem_1
__xcc_vm_fill_mem:
	ld	a, b
	cp	#16
	jr	nc, __xcc_vm_fill_mem_end
	call	__xopt_spaghetti_2
	add	a, #126
	add	a, b
	ld	c, a
	xor	b
	ld	(hl), a
	inc	b
	inc	hl
	jr	__xcc_vm_fill_mem
__xcc_vm_fill_mem_end:
	ld	a, #1
	call	_bench_seed_byte
	push	af
	ld	a, #2
	call	_bench_seed_byte
	push	af
	ld	a, #3
	call	_bench_seed_byte
	ld	b, a
	pop	af
	ld	d, a
	pop	af
	ld	e, a
	ld	c, #0
	ld	hl, #52719
__xcc_vm_outer:
	ld	a, c
	cp	#96
	jp	nc, __xcc_vm_done
	push	de
	push	hl
	call	__xopt_spaghetti_1
	pop	hl
	pop	de
	and	#7
	cp	#0
	jr	z, __xcc_vm_case0
	cp	#1
	jr	z, __xcc_vm_case1
	cp	#2
	jr	z, __xcc_vm_case2
	cp	#3
	jr	z, __xcc_vm_case3
	cp	#4
	jr	z, __xcc_vm_case4
	cp	#5
	jr	z, __xcc_vm_case5
	cp	#6
	jr	z, __xcc_vm_case6
	jr	__xcc_vm_default
__xcc_vm_case0:
	push	de
	push	hl
	call	__xopt_spaghetti_1
	pop	hl
	pop	de
	and	#15
	push	de
	push	hl
	call	__xopt_spaghetti_0
	pop	hl
	pop	de
	add	a, e
	ld	e, a
	jr	__xcc_vm_after_case
__xcc_vm_case1:
	push	de
	push	hl
	call	__xopt_spaghetti_1
	pop	hl
	pop	de
	srl	a
	and	#15
	push	de
	push	hl
	call	__xopt_spaghetti_0
	pop	hl
	pop	de
	xor	e
	ld	e, a
	jr	__xcc_vm_after_case
__xcc_vm_case2:
	ld	a, d
	add	a, e
	inc	a
	ld	d, a
	jr	__xcc_vm_after_case
__xcc_vm_case3:
	ld	a, d
	add	a, e
	xor	b
	ld	b, a
	jr	__xcc_vm_after_case
__xcc_vm_case4:
	ld	a, c
	and	#15
	push	de
	push	hl
	call	__xopt_spaghetti_0
	add	a, b
	ld	(hl), a
	pop	hl
	pop	de
	jr	__xcc_vm_after_case
__xcc_vm_case5:
	ld	a, e
	and	#1
	jr	z, __xcc_vm_after_case
	ld	a, c
	cp	#94
	jr	nc, __xcc_vm_after_case
	inc	c
	jr	__xcc_vm_after_case
__xcc_vm_case6:
	ld	a, e
	rlca
	ld	e, a
	jr	__xcc_vm_after_case
__xcc_vm_default:
	ld	a, e
	add	a, d
	add	a, b
	ld	e, a
__xcc_vm_after_case:
	push	bc
	push	de
	call	_bench_mix16
	ex	de, hl
	pop	de
	pop	bc
	push	bc
	push	de
	ld	e, b
	ld	d, #0
	call	_bench_mix16
	ex	de, hl
	pop	de
	pop	bc
	inc	c
	jp	__xcc_vm_outer
__xcc_vm_done:
	ex	de, hl
	ret
