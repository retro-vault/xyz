	.module	xcc_output
	.area	_CODE
	.globl	_use_plus1_twice
_use_plus1_twice:
	; sdcccall(1) prologue: use_plus1_twice (locals=0, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	ld	a, #1
	ld	e, a
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-6(ix), l
	ld	-5(ix), h
	ld	a, #1
	ld	e, a
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	b, h
	ld	c, l
	ld	l, -6(ix)
	ld	h, -5(ix)
	add	hl, bc
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__use_plus1_twice_end:
	; epilogue: use_plus1_twice
	ld	sp, ix
	pop	ix
	ret
