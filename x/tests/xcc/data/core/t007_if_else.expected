	.module xcc_output


	.area _CODE

	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=2, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	ld	hl, #5
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	hl, #3
	pop	de
	ex	de, hl
	or	a, a
	sbc	hl, de
	ld	hl, #0
	jp	z, __cmp_e_89383
	jp	m, __cmp_e_89383
	inc	l
__cmp_e_89383:
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, h
	or	a, l
	jp	nz, __xcc_L0
	jp	__xcc_L1
__xcc_L0:
	ld	hl, #1
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ex	de, hl
	jp	__main_end
	jp	__xcc_L2
__xcc_L1:
	ld	hl, #0
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ex	de, hl
	jp	__main_end
__xcc_L2:
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
