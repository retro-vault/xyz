diff --git a/libsrc/l/xcc/___muluint2ulong.asm b/libsrc/l/xcc/___muluint2ulong.asm
new file mode 100644
--- /dev/null
+++ b/libsrc/l/xcc/___muluint2ulong.asm
@@ -0,0 +1,26 @@
+SECTION code_clib
+SECTION code_l_xcc
+
+PUBLIC ___xcc_muluint2ulong
+
+; XCC sdcccall(1) unsigned 16x16 -> 32 multiply.
+;
+; enter : hl = multiplier, de = multiplicand
+; exit  : de = low word, hl = high word
+; uses  : f, b, de, hl, iy
+
+___xcc_muluint2ulong:
+   ld iy,0
+   ld b,16
+muluint2ulong_loop:
+   add iy,iy
+   adc hl,hl
+   jr nc,muluint2ulong_skip
+   add iy,de
+   jr nc,muluint2ulong_skip
+   inc hl
+muluint2ulong_skip:
+   djnz muluint2ulong_loop
+   push iy
+   pop de
+   ret
