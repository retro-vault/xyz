	.module	xcc_output
	.area	_CODE
_add1a:
	; sdcccall(1) prologue: add1a (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t2 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	ld	a, #1
	ld	e, a
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__add1a_end:
	; epilogue: add1a
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_merge
_use_merge:
	; sdcccall(1) prologue: use_merge (locals=0, temp_frame=8, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	ld	l, -2(ix)
	ld	h, -1(ix)
	.globl	_add1a
	call	_add1a
	push	de
	pop	hl
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	.globl	_add1a
	call	_add1a
	push	de
	pop	hl
	ld	b, h
	ld	c, l
	ld	l, -6(ix)
	ld	h, -5(ix)
	add	hl, bc
	ld	-8(ix), l
	ld	-7(ix), h
	ex	de, hl
__use_merge_end:
	; epilogue: use_merge
	ld	sp, ix
	pop	ix
	ret
