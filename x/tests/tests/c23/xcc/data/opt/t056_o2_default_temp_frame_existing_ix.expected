	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=4, temp_frame=6, stack_params=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param p at -2(ix)
	; receive (sdcccall1) param q at -4(ix)
	; receive (sdcccall1) param r at 4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	-6(ix), e
	ld	-5(ix), d
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	b, d
	ld	c, e
	ld	l, -6(ix)
	ld	h, -5(ix)
	add	hl, bc
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	b, d
	ld	c, e
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	a, l
	xor	a, c
	ld	l, a
	ld	a, h
	xor	a, b
	ld	h, a
	ld	-10(ix), l
	ld	-9(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	push	bc
	ret
