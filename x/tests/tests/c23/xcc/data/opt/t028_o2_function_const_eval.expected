	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #0
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #1
	ld	-4(ix), l
	ld	-3(ix), h
__xcc_L0:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	ld	hl, #4
	ex	de, hl
	or	a, a
	sbc	hl, de
	jp	m, __xcc_L1
	jr	nz, __xcc_L3
__xcc_L1:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, -4(ix)
	ld	d, -3(ix)
	add	hl, de
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L2:
	ld	l, -4(ix)
	ld	h, -3(ix)
	inc	hl
	ld	-4(ix), l
	ld	-3(ix), h
	jr	__xcc_L0
__xcc_L3:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
