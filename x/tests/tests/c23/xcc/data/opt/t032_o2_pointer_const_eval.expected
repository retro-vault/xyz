	.module	xcc_output
	.area	_CODE
_swap:
	; sdcccall(1) prologue: swap (locals=4, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	-6(ix), e
	ld	-5(ix), d
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	b, d
	ld	c, e
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	(hl), e
	inc	hl
	ld	(hl), d
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, -6(ix)
	ld	d, -5(ix)
	ld	(hl), e
	inc	hl
	ld	(hl), d
__swap_end:
	; epilogue: swap
	ld	sp, ix
	pop	ix
	ret
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=8, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	ld	hl, #10
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #20
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #5
	ld	-6(ix), l
	ld	-5(ix), h
	push	ix
	pop	hl
	ld	bc, #-6
	add	hl, bc
	ld	-8(ix), l
	ld	-7(ix), h
	push	ix
	pop	hl
	dec	hl
	dec	hl
	ld	-10(ix), l
	ld	-9(ix), h
	push	ix
	pop	hl
	dec	hl
	dec	hl
	dec	hl
	dec	hl
	ld	b, h
	ld	c, l
	ld	d, b
	ld	e, c
	ld	l, -10(ix)
	ld	h, -9(ix)
	.globl	_swap
	call	_swap
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	de, #42
	ld	(hl), e
	inc	hl
	ld	(hl), d
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, -4(ix)
	ld	d, -3(ix)
	add	hl, de
	ld	e, -6(ix)
	ld	d, -5(ix)
	add	hl, de
	ld	-12(ix), l
	ld	-11(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
