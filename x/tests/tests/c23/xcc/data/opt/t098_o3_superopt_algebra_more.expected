	.module	xcc_output
	.area	_CODE
	.globl	_dragon_algebra_more
_dragon_algebra_more:
	; sdcccall(1) prologue: dragon_algebra_more (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	and	#0
	or	#17
	xor	#255
	xor	a
	and	#247
	or	#17
	res	2, b
	res	5, c
__dragon_algebra_more_end:
	; epilogue: dragon_algebra_more
	ld	sp, ix
	pop	ix
	ret
