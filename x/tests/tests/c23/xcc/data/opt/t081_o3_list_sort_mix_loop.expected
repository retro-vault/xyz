	.module	xcc_output
	.area	_DATA
_main__nodes_0:
	.db	7
	.db	2
	.db	3
	.db	255
	.db	9
	.db	1
	.db	1
	.db	255
	.area	_CODE
_bench_mix16:
	; O3 sdcc-style leaf fast path: two-arg word mix helper
	ld	c, l
	ld	b, h
	ld	hl, #40503
	add	hl, de
	ld	a, c
	xor	l
	ld	l, a
	ld	a, b
	xor	h
	ld	b, a
	ld	h, a
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, b
	rrca
	rrca
	rrca
	and	#31
	or	l
	ld	l, a
	ld	a, e
	xor	#74
	ld	c, a
	ld	a, d
	xor	#127
	ld	b, a
	add	hl, bc
	ex	de, hl
	ret
	.globl	_main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=7, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-7
	add	hl, sp
	ld	sp, hl
	; O3 list-sort mix loop
	ld	hl, #13398
	xor	a
	ld	c, a
__xcc_L0:
	ld	a, c
	inc	a
	jr	z, __xcc_L2
__xcc_L1:
	ld	b, c
	ld	a, c
	add	a, a
	ld	e, a
	ld	d, #0
	push	hl
	ld	hl, #_main__nodes_0
	add	hl, de
	ld	e, (hl)
	inc	hl
	ld	c, (hl)
	ld	d, #0
	pop	hl
	push	bc
	call	_bench_mix16
	ex	de, hl
	pop	bc
	ld	e, b
	ld	d, #0
	push	bc
	call	_bench_mix16
	ex	de, hl
	pop	bc
	jr	__xcc_L0
__xcc_L2:
	ld	-5(ix), l
	ld	-4(ix), h
	ex	de, hl
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
