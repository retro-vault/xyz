	.module	xcc_output
	.area	_CODE
	.globl	_tame_os_dead_flag_span
_tame_os_dead_flag_span:
	; sdcccall(1) prologue: tame_os_dead_flag_span (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	xor	#0
	ld	h, a
	ld	-1(ix), h
	ld	a, #9
	cp	#7
	or	a
	ld	b, h
	ld	c, l
	sub	#1
__tame_os_dead_flag_span_end:
	; epilogue: tame_os_dead_flag_span
	ld	sp, ix
	pop	ix
	ret
