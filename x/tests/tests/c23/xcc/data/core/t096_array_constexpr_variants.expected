	.module xcc_output

	.area _DATA
_arr_enum:
	.ds 7
_arr_sizeof:
	.ds 3
_arr_macro:
	.ds 7
_arr_nested:
	.ds 19
_arr_combo:
	.ds 8


	.area _CODE

	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	a, #3
	ld	e, a
	ld	hl, #7
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ld	a, #7
	ld	e, a
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-4(ix), l
	ld	-3(ix), h
	ld	a, #19
	ld	e, a
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ld	a, #8
	ld	e, a
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
