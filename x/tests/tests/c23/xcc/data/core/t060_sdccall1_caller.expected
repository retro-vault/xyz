	.module xcc_output


	.area _CODE

	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #3
	push	hl
	ld	de, #2
	ld	hl, #1
	.globl _add3
	call	_add3
	pop	bc
	push	de
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
