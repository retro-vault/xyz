	.module xcc_output

	.globl _ext


	.area _CODE

	.globl _f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ld	hl, (_ext)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	jp	__f_end
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
