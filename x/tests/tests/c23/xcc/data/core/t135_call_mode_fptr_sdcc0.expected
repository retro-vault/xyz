	.module xcc_output

	.optsdcc -mz80 sdcccall(0)


	.area _CODE

	.globl _call_op
_call_op:
	; sdcccall(0) prologue: call_op (locals=0, temp_frame=4, stack_params=6)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall(0)) param op at 4(ix)
	; receive (sdcccall(0)) param a at 6(ix)
	; receive (sdcccall(0)) param b at 8(ix)
	ld	l, 8(ix)
	ld	h, 9(ix)
	push	hl
	ld	l, 6(ix)
	ld	h, 7(ix)
	push	hl
	.globl __sdcc_call_bc
	push	de
	push	hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	b, h
	ld	c, l
	pop	hl
	pop	de
	call	__sdcc_call_bc
	pop	bc
	pop	bc
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	jp	__call_op_end
__call_op_end:
	; epilogue: call_op
	ld	sp, ix
	pop	ix
	ret
