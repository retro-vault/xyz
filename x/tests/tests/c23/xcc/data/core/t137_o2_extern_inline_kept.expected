	.module	xcc_output
	.optsdcc	-mz80 sdcccall(1)
	.area	_CODE
	.globl	_helper
_helper:
	; sdcccall(1) prologue: helper (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t2 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	ld	a, #1
	ld	e, a
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__helper_end:
	; epilogue: helper
	ld	sp, ix
	pop	ix
	ret
	.globl	_main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	hl, #0
	ex	de, hl
__main_end:
	; epilogue: main
	ret
