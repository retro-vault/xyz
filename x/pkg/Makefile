REPO_ROOT ?= $(abspath ../..)
X_ROOT ?= $(abspath ..)
Y_ROOT ?= $(REPO_ROOT)/y
DIST_DIR ?= $(REPO_ROOT)/bin/x
BUILD_DIR ?= $(REPO_ROOT)/build
VSIX_STAGE_DIR ?= $(DIST_DIR)/pkg/vsix

SUBDIRS := xgdb-vsix debian

.PHONY: all clean $(SUBDIRS)

all: xgdb-vsix

debian: xgdb-vsix

$(SUBDIRS):
	$(MAKE) -C $@ \
		ROOT=$(REPO_ROOT) \
		X_ROOT=$(X_ROOT) \
		Y_ROOT=$(Y_ROOT) \
		BUILD_DIR=$(BUILD_DIR) \
		DIST_DIR=$(DIST_DIR) \
		VSIX_STAGE_DIR=$(VSIX_STAGE_DIR) \
		DEFAULT_PLATFORM=$(DEFAULT_PLATFORM) \
		PACKAGE_NAME=$(PACKAGE_NAME) \
		PACKAGE_VERSION=$(PACKAGE_VERSION) \
		PACKAGE_RELEASE=$(PACKAGE_RELEASE) \
		LIBC_PROFILE=$(LIBC_PROFILE) \
		LIBC_FLOAT=$(LIBC_FLOAT) \
		LIBC_DOUBLE=$(LIBC_DOUBLE) \
		LIBC_LONG=$(LIBC_LONG) \
		LIBC_LONGLONG=$(LIBC_LONGLONG) \
		LIBC_STDIO_FLOAT=$(LIBC_STDIO_FLOAT) \
		X_MODEL=$(X_MODEL)

clean:
	@for d in $(SUBDIRS); do \
		$(MAKE) -C $$d clean \
			ROOT=$(REPO_ROOT) \
			X_ROOT=$(X_ROOT) \
			Y_ROOT=$(Y_ROOT) \
			BUILD_DIR=$(BUILD_DIR) \
			DIST_DIR=$(DIST_DIR) \
			VSIX_STAGE_DIR=$(VSIX_STAGE_DIR) \
			DEFAULT_PLATFORM=$(DEFAULT_PLATFORM) \
			PACKAGE_NAME=$(PACKAGE_NAME) \
			PACKAGE_VERSION=$(PACKAGE_VERSION) \
			PACKAGE_RELEASE=$(PACKAGE_RELEASE) \
			LIBC_PROFILE=$(LIBC_PROFILE) \
			LIBC_FLOAT=$(LIBC_FLOAT) \
			LIBC_DOUBLE=$(LIBC_DOUBLE) \
			LIBC_LONG=$(LIBC_LONG) \
			LIBC_LONGLONG=$(LIBC_LONGLONG) \
			LIBC_STDIO_FLOAT=$(LIBC_STDIO_FLOAT) \
			X_MODEL=$(X_MODEL); \
	done
