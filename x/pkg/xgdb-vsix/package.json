{
  "name": "xgdb-vsix",
  "displayName": "xgdb",
  "description": "Visual Studio Code debugger integration for xgdb over DAP.",
  "version": "0.0.1",
  "publisher": "xgdb",
  "license": "MIT",
  "keywords": [
    "debugger",
    "dap",
    "z80",
    "xgdb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/retro-vault/xyz.git"
  },
  "bugs": {
    "url": "https://github.com/retro-vault/xyz/issues"
  },
  "homepage": "https://github.com/retro-vault/xyz",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "xgdb",
        "label": "xgdb",
        "languages": [
          "c",
          "cpp",
          "asm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "remoteTarget"
            ],
            "properties": {
              "name": {
                "type": "string",
                "default": "xgdb launch"
              },
              "type": {
                "type": "string",
                "enum": [
                  "xgdb"
                ]
              },
              "request": {
                "type": "string",
                "enum": [
                  "launch",
                  "attach"
                ],
                "default": "launch"
              },
              "program": {
                "type": "string",
                "description": "Target program image passed to xgdb. ELF files also provide symbols/debug information."
              },
              "symbols": {
                "type": "string",
                "description": "Optional explicit ELF symbol/debug file. Usually omit this when program is an ELF."
              },
              "cdbFile": {
                "type": "string",
                "description": "Optional SDCC/X debug information file."
              },
              "mapFile": {
                "type": "string",
                "description": "Optional linker map file."
              },
              "remoteTarget": {
                "type": "string",
                "description": "Remote target in host:port form."
              },
              "origin": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "Raw binary download origin. Ignored for ELF section placement."
              },
              "pc": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "Explicit program counter to set after download."
              },
              "startAddress": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "Compatibility alias for pc."
              },
              "noLoad": {
                "type": "boolean",
                "default": false,
                "description": "Do not download program to target on launch."
              },
              "debuggerPath": {
                "type": "string",
                "default": "xgdb",
                "description": "Path to the xgdb executable."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory used when launching xgdb."
              },
              "sourceRoot": {
                "type": "string",
                "description": "Optional source root for compatibility with udap launch configurations."
              },
              "sourceRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional source search roots for compatibility with udap launch configurations."
              },
              "includeRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional include/source search roots for compatibility with udap launch configurations."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              },
              "preLaunchTask": {
                "type": "string",
                "description": "Task to start the remote debug target."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "xgdb launch (dap)",
            "type": "xgdb",
            "request": "launch",
            "program": "${workspaceFolder}/app.elf",
            "remoteTarget": "127.0.0.1:9000",
            "debuggerPath": "${workspaceFolder}/../../bin/x/bin/xgdb",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "xgdb DAP",
            "description": "Launch xgdb as a DAP debugger for a remote target.",
            "body": {
              "name": "^\"xgdb launch\"",
              "type": "xgdb",
              "request": "launch",
              "program": "^\"${workspaceFolder}/program.elf\"",
              "remoteTarget": "^\"127.0.0.1:9000\"",
              "debuggerPath": "^\"xgdb\"",
              "cwd": "^\"${workspaceFolder}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "make all",
    "package:ci": "make all"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
