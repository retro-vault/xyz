	.module xcc_output


	.area _CODE

	.globl _atomic_op
_atomic_op:
	; critical prologue: atomic_op
	di
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ld	hl, #42
	ld	-2(ix), l
	ld	-1(ix), h
__atomic_op_end:
	; epilogue: atomic_op
	ld	sp, ix
	pop	ix
	; critical epilogue: atomic_op
	ei
	ret
