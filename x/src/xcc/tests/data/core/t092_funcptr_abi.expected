	.module xcc_output


	.area _CODE

	.globl _call_stack
_call_stack:
	; sdcccall(1) prologue: call_stack (locals=4, temp_frame=4, stack_params=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param op at -2(ix)
	; receive (sdcccall1) param a at -4(ix)
	; receive (sdcccall1) param b at 4(ix)
	ld	l, 4(ix)
	ld	h, 5(ix)
	push	hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	push	hl
	.globl __sdcc_call_bc
	push	de
	push	hl
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	b, h
	ld	c, l
	pop	hl
	pop	de
	call	__sdcc_call_bc
	pop	bc
	pop	bc
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ex	de, hl
	jp	__call_stack_end
__call_stack_end:
	; epilogue: call_stack
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	push	bc
	ret
	.globl _call_reg
_call_reg:
	; sdcccall(1) prologue: call_reg (locals=4, temp_frame=4, stack_params=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param op at -2(ix)
	; receive (sdcccall1) param a at -4(ix)
	; receive (sdcccall1) param b at 4(ix)
	ld	e, 4(ix)
	ld	d, 5(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	.globl __sdcc_call_bc
	push	de
	push	hl
	push	af
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	b, h
	ld	c, l
	pop	af
	pop	hl
	pop	de
	call	__sdcc_call_bc
	push	de
	pop	hl
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ex	de, hl
	jp	__call_reg_end
__call_reg_end:
	; epilogue: call_reg
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	push	bc
	ret
