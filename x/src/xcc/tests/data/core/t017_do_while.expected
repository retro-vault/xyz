	inc	hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L1:
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	hl, #5
	pop	de
	ex	de, hl
	or	a, a
	sbc	hl, de
	ld	hl, #1
	jp	m, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ld	a, h
