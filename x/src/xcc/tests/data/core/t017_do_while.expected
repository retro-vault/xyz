	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	ld	hl, #0
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #0
	ld	-4(ix), l
	ld	-3(ix), h
__xcc_L0:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, -2(ix)
	ld	d, -1(ix)
	add	hl, de
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -2(ix)
