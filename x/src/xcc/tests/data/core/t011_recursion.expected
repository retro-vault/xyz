	.module xcc_output


	.area _CODE

	.globl _fact
_fact:
	; sdcccall(1) prologue: fact (locals=2, temp_frame=12, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-14
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param n at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	hl, #1
	pop	de
	ex	de, hl
	or	a, a
	sbc	hl, de
	ld	hl, #1
	jp	z, __cmp_e_89383
	jp	m, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, h
	or	a, l
	jp	nz, __xcc_L0
	jp	__xcc_L2
__xcc_L0:
	ld	hl, #1
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ex	de, hl
	jp	__fact_end
	jp	__xcc_L2
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	.globl _fact
	call	_fact
	push	de
	pop	hl
	ld	-10(ix), l
	ld	-9(ix), h
	.globl __mul16
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	l, -10(ix)
	ld	h, -9(ix)
	pop	de
	call	__mul16
	ex	de, hl
	ld	-12(ix), l
	ld	-11(ix), h
	ld	l, -12(ix)
	ld	h, -11(ix)
	ld	-14(ix), l
	ld	-13(ix), h
	ld	l, -14(ix)
	ld	h, -13(ix)
	ex	de, hl
	jp	__fact_end
__fact_end:
	; epilogue: fact
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #5
	.globl _fact
	call	_fact
	push	de
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
