	.module xcc_output


	.area _CODE

	.globl _z88_stack_add3
_z88_stack_add3:
	; z88dk callee prologue: z88_stack_add3 (locals=0, temp_frame=4, stack_params=6)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (z88dk callee) param a at 4(ix)
	; receive (z88dk callee) param b at 6(ix)
	; receive (z88dk callee) param c at 8(ix)
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	e, 6(ix)
	ld	d, 7(ix)
	add	hl, de
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, 8(ix)
	ld	d, 9(ix)
	add	hl, de
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	jp	__z88_stack_add3_end
__z88_stack_add3_end:
	; epilogue: z88_stack_add3
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	inc	sp
	inc	sp
	inc	sp
	inc	sp
	push	bc
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #3
	push	hl
	ld	hl, #2
	push	hl
	ld	hl, #1
	push	hl
	.globl _z88_stack_add3
	call	_z88_stack_add3
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
