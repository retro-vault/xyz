	.module xcc_output

	.globl _PORT_WIDE
_PORT_WIDE = 4660

	.area _CODE

	.globl _set_wide
_set_wide:
	; sdcccall(1) prologue: set_wide (locals=1, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-1(ix), a
	ld	hl, #-1
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param v at -1(ix)
	ld	a, -1(ix)
	push	bc
	ld	bc, #4660
	out	(c), a
	pop	bc
__set_wide_end:
	; epilogue: set_wide
	ld	sp, ix
	pop	ix
	ret
	.globl _get_wide
_get_wide:
	; sdcccall(1) prologue: get_wide (locals=0, temp_frame=1, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-1
	add	hl, sp
	ld	sp, hl
	push	bc
	ld	bc, #4660
	in	a, (c)
	pop	bc
	ld	-1(ix), a
	ld	a, -1(ix)
	jp	__get_wide_end
__get_wide_end:
	; epilogue: get_wide
	ld	sp, ix
	pop	ix
	ret
