	.module xcc_output


	.area _CODE

	.globl _call_foreign_elf
_call_foreign_elf:
	; sdcccall(1) prologue: call_foreign_elf (locals=4, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	push	hl
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	.globl _foreign_elf_add
	call	_foreign_elf_add
	pop	bc
	pop	bc
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ex	de, hl
	jp	__call_foreign_elf_end
__call_foreign_elf_end:
	; epilogue: call_foreign_elf
	ld	sp, ix
	pop	ix
	ret
