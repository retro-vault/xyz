	.module xcc_output


	.area _CODE

	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=2, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #42
	ld	-2(ix), l
	ld	-1(ix), h
nop
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
