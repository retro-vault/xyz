	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	or	a, a
	jr	z, zero
	ld	hl, #1
	jr	done
zero:
	cp	#7
	jr	z, other
	ld	hl, #2
	jr	done
other:
	ld	hl, #3
done:
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
