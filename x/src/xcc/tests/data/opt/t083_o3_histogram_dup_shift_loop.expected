	.module	xcc_output
	.area	_DATA
_f__input_0:
	.ds	128
_f__bins_1:
	.ds	16
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=7, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-7
	add	hl, sp
	ld	sp, hl
	; O3 byte zero loop (count=16)
	ld	hl, #_f__bins_1
	ld	b, #16
	xor	a
__xcc_L0:
__xcc_L1:
	ld	(hl), a
	inc	hl
	djnz	__xcc_L1
__xcc_L3:
	; O3 nibble histogram loop (count=128)
	ld	bc, #0
__xcc_L4:
	ld	a, c
	cp	#128
	jr	nc, __xcc_L7
__xcc_L5:
	ld	hl, #_f__input_0
	add	hl, bc
	ld	a, (hl)
	rlca
	rlca
	rlca
	rlca
	and	#15
	ld	l, a
	ld	h, #0
	ld	de, #_f__bins_1
	add	hl, de
	inc	(hl)
	inc	c
	jr	__xcc_L4
__xcc_L7:
	ld	hl, #26505
	ld	-2(ix), l
	ld	-1(ix), h
	xor	a
	ld	-5(ix), a
__xcc_L8:
	ld	a, -5(ix)
	cp	#16
	jr	nc, __xcc_L11
__xcc_L9:
	ld	e, -5(ix)
	ld	d, #0
	ld	hl, #_f__bins_1
	add	hl, de
	ld	a, (hl)
	ld	-6(ix), a
	ld	h, -5(ix)
	ld	l, -6(ix)
	ld	b, h
	ld	c, l
	ld	l, -2(ix)
	ld	h, -1(ix)
	add	hl, bc
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L10:
	inc	-5(ix)
	jr	__xcc_L8
__xcc_L11:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
