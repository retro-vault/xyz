	.module	xcc_output
	.area	_CODE
	.globl	_tame_os_more
_tame_os_more:
	; sdcccall(1) prologue: tame_os_more (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	xor	#255
	sbc	a, #255
	cpl
	neg
	res	7, a
	and	a
	cp	#1
	xor	#2
__tame_os_more_end:
	; epilogue: tame_os_more
	ld	sp, ix
	pop	ix
	ret
