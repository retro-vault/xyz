	.module	xcc_output
	.area	_CODE
	.globl	_dispatch
_dispatch:
	; sdcccall(1) prologue: dispatch (locals=0, temp_frame=1, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t13 live in register for first use
	ld	hl, #-1
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; O3 jump-table switch (6 cases, span=6)
	; materialize incoming arg temp t13 for later reuse
	ld	-1(ix), a
	cp	#6
	jr	nc, __xcc_L6
	add	a, a
	ld	e, a
	ld	d, #0
	ld	hl, #__dispatch_swtab_2
	add	hl, de
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ex	de, hl
	jp	(hl)
__dispatch_swtab_2:
	.dw	__xcc_L0
	.dw	__xcc_L1
	.dw	__xcc_L2
	.dw	__xcc_L3
	.dw	__xcc_L4
	.dw	__xcc_L5
__xcc_L0:
	ld	a, #1
	jr	__dispatch_end
__xcc_L1:
	ld	a, #3
	jr	__dispatch_end
__xcc_L2:
	ld	a, #5
	jr	__dispatch_end
__xcc_L3:
	ld	a, #7
	jr	__dispatch_end
__xcc_L4:
	ld	a, #9
	jr	__dispatch_end
__xcc_L5:
	ld	a, #11
	jr	__dispatch_end
__xcc_L6:
	ld	a, #13
	jr	__dispatch_end
__xcc_L7:
__dispatch_end:
	; epilogue: dispatch
	ld	sp, ix
	pop	ix
	ret
