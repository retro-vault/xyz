	.module	xcc_output
	.area	_CODE
_sum_to:
	; sdcccall(1) prologue: sum_to (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	ld	hl, #0
	ld	-4(ix), l
	ld	-3(ix), h
__xcc_L0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	ld	hl, #0
	ex	de, hl
	or	a, a
	sbc	hl, de
	jr	z, __xcc_L2
	jp	m, __xcc_L2
__xcc_L1:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, -2(ix)
	ld	d, -1(ix)
	add	hl, de
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	hl
	ld	-2(ix), l
	ld	-1(ix), h
	jr	__xcc_L0
__xcc_L2:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	b, h
	ld	c, l
	ex	de, hl
__sum_to_end:
	; epilogue: sum_to
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_a
_use_a:
	; sdcccall(1) prologue: use_a (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	hl, #4
	.globl	_sum_to
	jr	_sum_to
__use_a_end:
	; epilogue: use_a
	.globl	_use_b
_use_b:
	; sdcccall(1) prologue: use_b (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	hl, #6
	.globl	_sum_to
	jr	_sum_to
__use_b_end:
	; epilogue: use_b
