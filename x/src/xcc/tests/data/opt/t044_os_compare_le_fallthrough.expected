	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-4(ix), l
	ld	-3(ix), h
	; keep incoming register arg t6 live in register for first use
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	ld	l, -4(ix)
	ld	h, -3(ix)
	push	hl
	ld	h, d
	ld	l, e
	; materialize incoming arg temp t6 for later reuse
	ld	-2(ix), e
	ld	-1(ix), d
	pop	de
	ex	de, hl
	or	a, a
	sbc	hl, de
	jp	m, __xcc_L0
	jr	nz, __xcc_L2
__xcc_L0:
	ld	l, -4(ix)
	ld	h, -3(ix)
	inc	hl
	ld	b, h
	ld	c, l
	ex	de, hl
	jr	__f_end
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
