	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=8, stack_params=4)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) param c at 4(ix)
	; receive (sdcccall1) param d at 6(ix)
	.globl	__mul16
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	call	__mul16
	ex	de, hl
	ld	b, h
	ld	c, l
	ld	e, 4(ix)
	ld	d, 5(ix)
	add	hl, de
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, 6(ix)
	ld	h, 7(ix)
	ld	de, #2
	or	a, a
	sbc	hl, de
	ld	b, h
	ld	c, l
	.globl	__mul16
	ld	l, -6(ix)
	ld	h, -5(ix)
	push	hl
	ld	h, b
	ld	l, c
	pop	de
	call	__mul16
	ex	de, hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, -4(ix)
	ld	d, -3(ix)
	or	a, a
	sbc	hl, de
	ld	b, h
	ld	c, l
	.globl	__mul16
	ex	de, hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	call	__mul16
	ex	de, hl
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	e, -6(ix)
	ld	d, -5(ix)
	add	hl, de
	ld	a, #42
	ld	e, a
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	add	hl, hl
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, l
	and	a, e
	ld	l, a
	ld	a, h
	and	a, d
	ld	h, a
	ld	b, h
	ld	c, l
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	a, l
	or	a, c
	ld	l, a
	ld	a, h
	or	a, b
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	inc	sp
	inc	sp
	push	bc
	ret
