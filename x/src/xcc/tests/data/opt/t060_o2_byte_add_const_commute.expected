	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t5 live in register for first use
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	and	#7
	ld	-1(ix), a
	add	a, #48
	ld	-2(ix), a
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
