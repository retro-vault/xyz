	.module	xcc_output
	.area	_DATA
	.globl	_hoist_buf
_hoist_buf:
	.ds	16
	.area	_CODE
	.globl	_dragon_hoist_d_zero
_dragon_hoist_d_zero:
	; sdcccall(1) prologue: dragon_hoist_d_zero (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	de, #0
hoist_d_zero_loop:
	ld	a, e
	ld	hl, #_hoist_buf
	add	hl, de
	ld	(hl), a
	inc	e
	ld	a, e
	sub	#16
	jr	c, hoist_d_zero_loop
__dragon_hoist_d_zero_end:
	; epilogue: dragon_hoist_d_zero
	ld	sp, ix
	pop	ix
	ret
