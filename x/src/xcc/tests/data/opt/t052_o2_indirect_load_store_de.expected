	.module	xcc_output
	.area	_CODE
	.globl	_fetch
_fetch:
	; sdcccall(1) prologue: fetch (locals=2, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg p live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) param p at -2(ix)
	ld	e, (hl)
	inc	hl
	ld	d, (hl)
	ld	b, d
	ld	c, e
	ld	h, b
	ld	l, c
	ex	de, hl
__fetch_end:
	; epilogue: fetch
	ld	sp, ix
	pop	ix
	ret
