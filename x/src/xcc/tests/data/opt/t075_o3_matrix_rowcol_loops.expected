	.module	xcc_output
	.area	_DATA
_src:
	.ds	64
_row_sum:
	.ds	8
_col_sum:
	.ds	8
	.area	_CODE
	.globl	_main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=16, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-16
	add	hl, sp
	ld	sp, hl
	; O3 dual zero byte walk loop (count=8)
	ld	hl, #row_sum
	ld	de, #col_sum
	ld	b, #8
	xor	a
__xcc_L0:
__xcc_L1:
	ld	(hl), a
	ld	(de), a
	inc	hl
	inc	de
	djnz	__xcc_L1
__xcc_L3:
	; O3 matrix row/col accumulation loop (rows=8 cols=8)
	ld	hl, #src
	ld	de, #row_sum
	ld	c, #8
__xcc_L4:
	ld	a, c
	or	a
	jr	z, __xcc_L7
__xcc_L5:
	push	bc
	push	de
	ld	a, (de)
	ex	af, af'
	ld	de, #col_sum
	ld	b, #8
__xcc_L8:
__xcc_L9:
	ld	c, (hl)
	inc	hl
	ld	a, (de)
	add	a, c
	ld	(de), a
	inc	de
	ex	af, af'
	add	a, c
	ex	af, af'
	djnz	__xcc_L9
__xcc_L6:
	pop	de
	ex	af, af'
	ld	(de), a
	ex	af, af'
	inc	de
	pop	bc
	dec	c
	jr	nz, __xcc_L4
__xcc_L7:
	xor	a
	ld	-6(ix), a
	ld	-1(ix), a
__xcc_L12:
	ld	a, -1(ix)
	cp	#8
	jr	nc, __xcc_L15
__xcc_L13:
	ld	e, -1(ix)
	ld	d, #0
	ld	hl, #_row_sum
	add	hl, de
	ld	a, (hl)
	ld	-13(ix), a
	ld	e, -1(ix)
	ld	d, #0
	ld	hl, #_col_sum
	add	hl, de
	ld	a, (hl)
	ld	-14(ix), a
	ld	e, -13(ix)
	ld	d, -14(ix)
	ld	a, e
	xor	a, d
	ld	-15(ix), a
	ld	e, -6(ix)
	ld	d, -15(ix)
	ld	a, e
	add	a, d
	ld	-6(ix), a
__xcc_L14:
	inc	-1(ix)
	jr	__xcc_L12
__xcc_L15:
	ld	a, -6(ix)
	ld	l, a
	ld	h, #0
	ex	de, hl
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
