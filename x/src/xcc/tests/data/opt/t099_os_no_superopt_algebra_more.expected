	.module	xcc_output
	.area	_CODE
	.globl	_tame_os_algebra_more
_tame_os_algebra_more:
	; sdcccall(1) prologue: tame_os_algebra_more (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	and	#240
	and	#15
	or	#16
	or	#1
	xor	#85
	xor	#170
	xor	b
	xor	b
	cpl
	xor	#255
	ld	a, #85
	and	#15
	ld	a, #16
	or	#1
	ld	a, #170
	xor	#170
	res	3, a
	and	#255
	set	4, a
	or	#1
	set	2, b
	res	2, b
	res	5, c
	res	5, c
__tame_os_algebra_more_end:
	; epilogue: tame_os_algebra_more
	ld	sp, ix
	pop	ix
	ret
