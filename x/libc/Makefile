_THIS_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROOT ?= $(abspath $(_THIS_DIR)/..)
BUILD_DIR ?= $(ROOT)/build
DIST_DIR ?= $(ROOT)/bin/x
HOST_BIN_DIR ?= $(DIST_DIR)/bin
TARGET_DIR ?= $(DIST_DIR)/z80
TARGET_LIB_DIR ?= $(TARGET_DIR)/lib
TARGET_INCLUDE_DIR ?= $(TARGET_DIR)/include
C8FLAGS ?= -I$(ROOT)/libc/include -I$(ROOT)/platforms/include
AS8FLAGS ?= --mode=sdcc
LIBC_PROFILE ?= full
include $(ROOT)/mk/model.mk
LIBC_FLOAT     ?= $(X_MODEL_LIBC_FLOAT_DEFAULT)
LIBC_DOUBLE    ?= $(X_MODEL_LIBC_DOUBLE_DEFAULT)
LIBC_LONG      ?= $(X_MODEL_LIBC_LONG_DEFAULT)
LIBC_LONGLONG  ?= $(X_MODEL_LIBC_LONGLONG_DEFAULT)
LIBC_STDIO_FLOAT ?= $(X_MODEL_LIBC_STDIO_FLOAT_DEFAULT)
ifeq ($(LIBC_FLOAT),0)
override LIBC_STDIO_FLOAT := 0
endif

LIBC_BUILD_FLAVOR := $(LIBC_PROFILE)-$(X_MODEL_NAME)-f$(LIBC_FLOAT)-d$(LIBC_DOUBLE)-l$(LIBC_LONG)-ll$(LIBC_LONGLONG)-sf$(LIBC_STDIO_FLOAT)
BUILD_TARGET := $(BUILD_DIR)/lib/libc/$(LIBC_BUILD_FLAVOR)/libc.a
DIST_TARGET  := $(TARGET_LIB_DIR)/libc.a

.PHONY: all build clean stage-headers

all: $(DIST_TARGET) stage-headers

build:
	$(MAKE) -C src ROOT=$(ROOT) BUILD_DIR=$(BUILD_DIR) DIST_DIR=$(DIST_DIR) HOST_BIN_DIR=$(HOST_BIN_DIR) WITH_SYS=0 AR8FLAGS="--mode=gnu rcs" C8FLAGS="$(C8FLAGS)" AS8FLAGS="$(AS8FLAGS)" LIBC_PROFILE="$(LIBC_PROFILE)" LIBC_FLOAT="$(LIBC_FLOAT)" LIBC_DOUBLE="$(LIBC_DOUBLE)" LIBC_LONG="$(LIBC_LONG)" LIBC_LONGLONG="$(LIBC_LONGLONG)" LIBC_STDIO_FLOAT="$(LIBC_STDIO_FLOAT)" X_MODEL="$(X_MODEL_NAME)"

$(DIST_TARGET): build | $(TARGET_LIB_DIR)
	cp $(BUILD_TARGET) $@

stage-headers: | $(TARGET_INCLUDE_DIR)
	cp -R include/. $(TARGET_INCLUDE_DIR)/

$(TARGET_INCLUDE_DIR):
	mkdir -p $@

$(TARGET_LIB_DIR):
	mkdir -p $@

clean:
	$(MAKE) -C src clean ROOT=$(ROOT) BUILD_DIR=$(BUILD_DIR) DIST_DIR=$(DIST_DIR) HOST_BIN_DIR=$(HOST_BIN_DIR)
	rm -f $(DIST_TARGET)
