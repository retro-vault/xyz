	.module xcc_output

	.area _DATA
	.globl _a
_a:
	.dw 2611


	.area _CODE

	.globl _area
_area:
	; sdcccall(1) prologue: area (locals=4, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param w at -2(ix)
	; receive (sdcccall1) param h at -4(ix)
	.globl _fixed8_8_mul
	ld	e, -4(ix)
	ld	d, -3(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	call	_fixed8_8_mul
	push	de
	pop	hl
	ld	-6(ix), l
	ld	-5(ix), h
	.globl _fixed8_8_add
	ld	de, #384
	ld	l, -6(ix)
	ld	h, -5(ix)
	call	_fixed8_8_add
	push	de
	pop	hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ex	de, hl
	jp	__area_end
__area_end:
	; epilogue: area
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=10, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	ld	de, #768
	ld	hl, #512
	.globl _area
	call	_area
	push	de
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	.globl _fixed8_8_to_int
	ld	l, -2(ix)
	ld	h, -1(ix)
	call	_fixed8_8_to_int
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-6(ix), l
	ld	-5(ix), h
	ld	hl, #2
	ld	e, -6(ix)
	ld	d, -5(ix)
	add	hl, de
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
