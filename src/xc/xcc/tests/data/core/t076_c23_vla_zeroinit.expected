	.module xcc_output


	.area _CODE

	.globl _zero_test
_zero_test:
	; prologue: zero_test (locals=8)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive param n at 4(ix)
	.globl __mul16
	ld	hl, #2
	push	hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	push	hl
	call	__mul16
	pop	bc
	pop	bc
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	ld	hl, #0
	add	hl, sp
	or	a, a
	sbc	hl, de
	ld	sp, hl
	dec	sp
	dec	sp
	ld	-12(ix), l
	ld	-11(ix), h
	ld	l, -12(ix)
	ld	h, -11(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	.globl __mul16
	ld	hl, #2
	push	hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	push	hl
	call	__mul16
	pop	bc
	pop	bc
	dec	sp
	dec	sp
	ld	-14(ix), l
	ld	-13(ix), h
	ld	l, -14(ix)
	ld	h, -13(ix)
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -14(ix)
	ld	h, -13(ix)
	ex	de, hl
	ld	hl, #0
	add	hl, sp
	or	a, a
	sbc	hl, de
	ld	sp, hl
	dec	sp
	dec	sp
	ld	-16(ix), l
	ld	-15(ix), h
	ld	l, -16(ix)
	ld	h, -15(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	dec	sp
	dec	sp
	ld	-18(ix), l
	ld	-17(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	dec	sp
	dec	sp
	ld	-20(ix), l
	ld	-19(ix), h
__zero_test_end:
	; epilogue: zero_test
	ld	sp, ix
	pop	ix
	ret
