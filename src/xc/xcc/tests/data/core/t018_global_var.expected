	.module xcc_output

	.area _DATA
	.globl _counter
_counter:
	.ds 2


	.area _CODE

	.globl _increment
_increment:
	; sdcccall(1) prologue: increment (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ld	a, #1
	ld	e, a
	ld	hl, (_counter)
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	(_counter), hl
__increment_end:
	; epilogue: increment
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	.globl _increment
	call	_increment
	.globl _increment
	call	_increment
	.globl _increment
	call	_increment
	ld	hl, (_counter)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
