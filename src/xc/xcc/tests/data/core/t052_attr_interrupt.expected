	.module xcc_output


	.area _CODE

	.globl _my_isr
_my_isr:
	; interrupt prologue: my_isr
	push	af
	push	bc
	push	de
	push	hl
	push	iy
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ld	hl, #1
	ld	-2(ix), l
	ld	-1(ix), h
__my_isr_end:
	; interrupt epilogue: my_isr
	ld	sp, ix
	pop	ix
	pop	iy
	pop	hl
	pop	de
	pop	bc
	pop	af
	reti
