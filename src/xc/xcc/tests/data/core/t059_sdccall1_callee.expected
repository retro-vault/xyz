	.module xcc_output


	.area _CODE

	.globl _add3
_add3:
	; sdcccall(1) prologue: add3 (locals=6, reg_params=3)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	-6(ix), c
	ld	-5(ix), b
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	; receive (sdcccall1) param c at -6(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, -4(ix)
	ld	d, -3(ix)
	add	hl, de
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	e, -6(ix)
	ld	d, -5(ix)
	add	hl, de
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	jp	__add3_end
__add3_end:
	; epilogue: add3
	ld	sp, ix
	pop	ix
	ret
