	.module xcc_output


	.area _CODE

	.globl _add
_add:
	; sdcccall(1) prologue: add (locals=4, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	e, -4(ix)
	ld	d, -3(ix)
	pop	hl
	add	hl, de
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ex	de, hl
	jp	__add_end
__add_end:
	; epilogue: add
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	de, #4
	ld	hl, #3
	.globl _add
	call	_add
	push	de
	pop	hl
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
