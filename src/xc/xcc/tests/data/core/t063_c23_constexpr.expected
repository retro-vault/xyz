	.module xcc_output

	.area _DATA
	.globl _LIMIT
_LIMIT:
	.dw 32
	.globl _arr
_arr:
	.ds 2


	.area _CODE

	.globl _get_limit
_get_limit:
	; sdcccall(1) prologue: get_limit (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, (_LIMIT)
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	jp	__get_limit_end
__get_limit_end:
	; epilogue: get_limit
	ld	sp, ix
	pop	ix
	ret
