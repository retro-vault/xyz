	.module xcc_output


	.area _CODE

	.globl _z88_fast_inc
_z88_fast_inc:
	; z88dk fastcall prologue: z88_fast_inc (locals=2, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (z88dk fastcall) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	jp	__z88_fast_inc_end
__z88_fast_inc_end:
	; epilogue: z88_fast_inc
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #7
	.globl _z88_fast_inc
	call	_z88_fast_inc
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
