	.module xcc_output

	.area _DATA
	.globl _small
_small:
	.ds 1
	.globl _port
_port:
	.dw 65535
	.globl _large
_large:
	.ds 4


	.area _CODE

	.globl _get_port
_get_port:
	; sdcccall(1) prologue: get_port (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, (_port)
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__get_port_end
__get_port_end:
	; epilogue: get_port
	ld	sp, ix
	pop	ix
	ret
