	.module xcc_output

	.area _DATA
	.globl _aligned_var
_aligned_var:
	.ds 2


	.area _CODE

	.globl _get_align
_get_align:
	; sdcccall(1) prologue: get_align (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #2
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__get_align_end
__get_align_end:
	; epilogue: get_align
	ld	sp, ix
	pop	ix
	ret
