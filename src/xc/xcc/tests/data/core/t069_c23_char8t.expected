	.module xcc_output

	.area _DATA
	.globl _buf
_buf:
	.db 195
	.db 169
	.db 0
	.db 0


	.area _CODE

	.globl _get_first
_get_first:
	; sdcccall(1) prologue: get_first (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #_buf
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	de, #0
	add	hl, de
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, (hl)
	dec	sp
	dec	sp
	ld	-6(ix), a
	ld	a, -6(ix)
	ld	l, a
	ld	h, #0
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	jp	__get_first_end
__get_first_end:
	; epilogue: get_first
	ld	sp, ix
	pop	ix
	ret
	.globl _get_second
_get_second:
	; sdcccall(1) prologue: get_second (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #_buf
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, (hl)
	dec	sp
	dec	sp
	ld	-6(ix), a
	ld	a, -6(ix)
	ld	l, a
	ld	h, #0
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	jp	__get_second_end
__get_second_end:
	; epilogue: get_second
	ld	sp, ix
	pop	ix
	ret
