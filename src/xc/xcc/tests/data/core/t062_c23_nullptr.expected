	.module xcc_output


	.area _CODE

	.globl _make_null
_make_null:
	; sdcccall(1) prologue: make_null (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ld	hl, #0
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	jp	__make_null_end
__make_null_end:
	; epilogue: make_null
	ld	sp, ix
	pop	ix
	ret
