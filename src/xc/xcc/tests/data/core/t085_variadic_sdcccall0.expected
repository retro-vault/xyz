	.module xcc_output


	.area _CODE

	.globl _pick
_pick:
	; sdcccall(0) prologue: pick (locals=0, temp_frame=2, stack_params=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall(0)) param first at 4(ix)
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	jp	__pick_end
__pick_end:
	; epilogue: pick
	ld	sp, ix
	pop	ix
	ret
	.globl _use
_use:
	; sdcccall(1) prologue: use (locals=2, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param fn at -2(ix)
	ld	hl, #4
	push	hl
	ld	hl, #3
	push	hl
	.globl __sdcc_call_bc
	push	de
	push	hl
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	b, h
	ld	c, l
	pop	hl
	pop	de
	call	__sdcc_call_bc
	pop	bc
	pop	bc
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ex	de, hl
	jp	__use_end
__use_end:
	; epilogue: use
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #_pick
	.globl _use
	call	_use
	push	de
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
