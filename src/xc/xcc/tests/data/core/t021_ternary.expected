	.module xcc_output


	.area _CODE

	.globl _max
_max:
	; sdcccall(1) prologue: max (locals=4, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	pop	de
	ex	de, hl
	or	a, a
	sbc	hl, de
	ld	hl, #0
	jp	z, __cmp_e_89383
	jp	m, __cmp_e_89383
	inc	l
__cmp_e_89383:
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	a, h
	or	a, l
	jp	nz, __xcc_L0
	jp	__xcc_L1
__xcc_L0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	jp	__xcc_L2
__xcc_L1:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-8(ix), l
	ld	-7(ix), h
__xcc_L2:
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	jp	__max_end
__max_end:
	; epilogue: max
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	de, #7
	ld	hl, #10
	.globl _max
	call	_max
	push	de
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
