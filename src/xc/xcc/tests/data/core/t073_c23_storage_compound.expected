	.module xcc_output

	.area _DATA
___sclit0:
	.dw 1
	.dw 2
	.dw 3
	.dw 4
___sclit1:
	.db 104
	.db 101
	.db 108
	.db 108
	.db 111
	.db 0


	.area _CODE

	.globl _get_table
_get_table:
	; sdcccall(1) prologue: get_table (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #___sclit0
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__get_table_end
__get_table_end:
	; epilogue: get_table
	ld	sp, ix
	pop	ix
	ret
	.globl _get_msg
_get_msg:
	; sdcccall(1) prologue: get_msg (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	ld	hl, #___sclit1
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__get_msg_end
__get_msg_end:
	; epilogue: get_msg
	ld	sp, ix
	pop	ix
	ret
