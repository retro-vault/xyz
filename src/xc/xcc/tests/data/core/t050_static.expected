	.module xcc_output

	.area _DATA
_counter__n_0:
	.ds 2


	.area _CODE

	.globl _counter
_counter:
	; sdcccall(1) prologue: counter (locals=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, (_counter__n_0)
	inc	hl
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	(_counter__n_0), hl
	ld	hl, (_counter__n_0)
	ex	de, hl
	jp	__counter_end
__counter_end:
	; epilogue: counter
	ld	sp, ix
	pop	ix
	ret
_double_it:
	; sdcccall(1) prologue: double_it (locals=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	.globl __mul16
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	hl, #2
	pop	de
	call	__mul16
	push	de
	pop	hl
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__double_it_end
__double_it_end:
	; epilogue: double_it
	ld	sp, ix
	pop	ix
	ret
	.globl _use_double
_use_double:
	; sdcccall(1) prologue: use_double (locals=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	.globl _double_it
	call	_double_it
	push	de
	pop	hl
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__use_double_end
__use_double_end:
	; epilogue: use_double
	ld	sp, ix
	pop	ix
	ret
