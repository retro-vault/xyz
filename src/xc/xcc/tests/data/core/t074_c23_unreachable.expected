	.module xcc_output


	.area _CODE

	.globl _panic
_panic:
	; sdcccall(1) prologue: panic (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	.globl __builtin_unreachable
	call	__builtin_unreachable
__panic_end:
	; epilogue omitted: panic is [[noreturn]]
	.globl _safe_div
_safe_div:
	; sdcccall(1) prologue: safe_div (locals=4, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	push	hl
	ld	hl, #0
	pop	de
	or	a, a
	sbc	hl, de
	ld	hl, #1
	jp	z, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	a, h
	or	a, l
	jp	nz, __xcc_L0
	jp	__xcc_L2
__xcc_L0:
	.globl _panic
	call	_panic
	.globl __builtin_unreachable
	call	__builtin_unreachable
	jp	__xcc_L2
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	e, -4(ix)
	ld	d, -3(ix)
	pop	hl
	.globl __divsint
	call	__divsint
	ex	de, hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -10(ix)
	ld	h, -9(ix)
	ex	de, hl
	jp	__safe_div_end
__safe_div_end:
	; epilogue: safe_div
	ld	sp, ix
	pop	ix
	ret
