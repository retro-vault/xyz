	.module xcc_output


	.area _CODE

	.globl _add
_add:
	; sdcccall(0) prologue: add (locals=0, temp_frame=4, stack_params=4)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall(0)) param a at 4(ix)
	; receive (sdcccall(0)) param b at 6(ix)
	ld	l, 4(ix)
	ld	h, 5(ix)
	push	hl
	ld	e, 6(ix)
	ld	d, 7(ix)
	pop	hl
	add	hl, de
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	jp	__add_end
__add_end:
	; epilogue: add
	ld	sp, ix
	pop	ix
	ret
	.globl _main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #2
	push	hl
	ld	hl, #1
	push	hl
	.globl _add
	call	_add
	pop	bc
	pop	bc
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	jp	__main_end
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
