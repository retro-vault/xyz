	.module	xcc_output
	.area	_CODE
_keep_second:
	; sdcccall(1) prologue: keep_second (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	; receive (sdcccall1) register param already materialized in prologue
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	dec	sp
	dec	sp
	ld	-6(ix), l
	ld	-5(ix), h
	ex	de, hl
__keep_second_end:
	; epilogue: keep_second
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_second
_use_second:
	; sdcccall(1) prologue: use_second (locals=2, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	.globl	_keep_second
	call	_keep_second
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	-6(ix), l
	ld	-5(ix), h
	ex	de, hl
__use_second_end:
	; epilogue: use_second
	ld	sp, ix
	pop	ix
	ret
