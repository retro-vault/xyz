	.module	xcc_output
	.area	_CODE
_keep_second:
	; sdcccall(1) prologue: keep_second (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t2 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	ld	a, #1
	ld	e, a
	ld	a, l
	add	a, e
	ld	l, a
	ld	a, h
	adc	a, #0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__keep_second_end:
	; epilogue: keep_second
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_second
_use_second:
	; sdcccall(1) prologue: use_second (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	b, h
	ld	c, l
	ld	h, b
	ld	l, c
	.globl	_keep_second
	jr	_keep_second
__use_second_end:
	; epilogue: use_second
