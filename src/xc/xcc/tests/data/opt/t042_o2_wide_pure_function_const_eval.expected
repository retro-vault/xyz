	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=8, temp_frame=8, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-16
	add	hl, sp
	ld	sp, hl
	ld	hl, #4464
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #1
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #3
	ld	-8(ix), l
	ld	-7(ix), h
	ld	hl, #0
	ld	-6(ix), l
	ld	-5(ix), h
	.globl	__mul32
	push	hl
	ld	l, -8(ix)
	ld	h, -7(ix)
	push	hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	ld	l, -2(ix)
	ld	h, -1(ix)
	call	__mul32
	pop	bc
	pop	bc
	ld	b, h
	ld	c, l
	ex	de, hl
	ld	-12(ix), l
	ld	-11(ix), h
	ld	h, b
	ld	l, c
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -12(ix)
	ld	h, -11(ix)
	ld	-16(ix), l
	ld	-15(ix), h
	ex	de, hl
	ld	l, -14(ix)
	ld	h, -13(ix)
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
