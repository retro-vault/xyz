	.module	xcc_output
	.area	_CODE
	.globl	_shift_twice
_shift_twice:
	; sdcccall(1) prologue: shift_twice (locals=4, temp_frame=4, stack_params=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-8
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	; receive (sdcccall1) param a at -4(ix)
	; receive (sdcccall1) param b at 4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	b, l
	pop	hl
	.globl	__shl16
	call	__shl16
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	b, l
	pop	hl
	.globl	__shl16
	call	__shl16
	ld	b, h
	ld	c, l
	ld	l, -6(ix)
	ld	h, -5(ix)
	push	hl
	ld	h, b
	ld	l, c
	pop	de
	ld	a, l
	xor	a, e
	ld	l, a
	ld	a, h
	xor	a, d
	ld	h, a
	ld	-8(ix), l
	ld	-7(ix), h
	ld	b, h
	ld	c, l
	ex	de, hl
__shift_twice_end:
	; epilogue: shift_twice
	ld	sp, ix
	pop	ix
	pop	bc
	inc	sp
	inc	sp
	push	bc
	ret
