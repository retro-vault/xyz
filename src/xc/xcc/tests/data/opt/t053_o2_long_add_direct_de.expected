	.module	xcc_output
	.area	_CODE
	.globl	_add_params
_add_params:
	; sdcccall(1) prologue: add_params (locals=0, temp_frame=12, stack_params=4)
	push	ix
	ld	ix, #0
	add	ix, sp
	push	hl
	ex	de, hl
	ld	-4(ix), l
	ld	-3(ix), h
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) param b at 4(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, 4(ix)
	ld	d, 5(ix)
	add	hl, de
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, 6(ix)
	ld	d, 7(ix)
	adc	hl, de
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-12(ix), l
	ld	-11(ix), h
	ex	de, hl
	ld	l, -10(ix)
	ld	h, -9(ix)
__add_params_end:
	; epilogue: add_params
	ld	sp, ix
	pop	ix
	ret
	.globl	_sub_params
_sub_params:
	; sdcccall(1) prologue: sub_params (locals=0, temp_frame=12, stack_params=4)
	push	ix
	ld	ix, #0
	add	ix, sp
	push	hl
	ex	de, hl
	ld	-4(ix), l
	ld	-3(ix), h
	pop	hl
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) param b at 4(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	e, 4(ix)
	ld	d, 5(ix)
	or	a, a
	sbc	hl, de
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, 6(ix)
	ld	d, 7(ix)
	sbc	hl, de
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-12(ix), l
	ld	-11(ix), h
	ex	de, hl
	ld	l, -10(ix)
	ld	h, -9(ix)
__sub_params_end:
	; epilogue: sub_params
	ld	sp, ix
	pop	ix
	ret
