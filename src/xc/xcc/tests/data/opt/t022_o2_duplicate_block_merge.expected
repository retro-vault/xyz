	.module	xcc_output
	.area	_CODE
_choose:
	; sdcccall(1) prologue: choose (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	push	de
	pop	hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	jr	dispatch
a:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	de, #5
	add	hl, de
	ld	-4(ix), l
	ld	-3(ix), h
	jr	done
b:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	de, #5
	add	hl, de
	ld	-4(ix), l
	ld	-3(ix), h
	jr	done
dispatch:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, h
	or	a, l
	jr	nz, a
	jr	b
done:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, l
	xor	#3
	ld	l, a
	ld	a, h
	xor	#0
	ld	h, a
	ld	b, h
	ld	c, l
	ex	de, hl
__choose_end:
	; epilogue: choose
	ld	sp, ix
	pop	ix
	ret
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	b, d
	ld	c, e
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	ld	d, b
	ld	e, c
	ld	l, -2(ix)
	ld	h, -1(ix)
	.globl	_choose
	call	_choose
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
