	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=2, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, h
	or	a, l
	jp	z, __xcc_L2
__xcc_L0:
	ld	hl, #1
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-4(ix), l
	ld	-3(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
