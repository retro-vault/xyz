	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; prologue: f (locals=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; receive param x at 4(ix)
	ld	l, 4(ix)
	ld	h, 5(ix)
	ld	a, h
	or	a, l
	jp	z, __xcc_L2
__xcc_L0:
	ld	hl, #1
	ld	4(ix), l
	ld	5(ix), h
__xcc_L2:
	ld	l, 4(ix)
	ld	h, 5(ix)
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
