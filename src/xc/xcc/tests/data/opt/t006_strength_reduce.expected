	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=2, temp_frame=8, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	add	hl, hl
	add	hl, hl
	ld	-4(ix), l
	ld	-3(ix), h
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	hl, #3
	ld	b, l
	pop	hl
	ld	a, b
	or	a, a
	jp	z, __sdone_886
__shift_9383:
	srl	h
	rr	l
	djnz	__shift_9383
__sdone_886:
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	push	hl
	ld	e, -6(ix)
	ld	d, -5(ix)
	pop	hl
	add	hl, de
	ld	-8(ix), l
	ld	-7(ix), h
	ld	-10(ix), l
	ld	-9(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
