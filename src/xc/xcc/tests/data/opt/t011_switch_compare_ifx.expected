	.module	xcc_output
	.area	_CODE
	.globl	_pick
_pick:
	; sdcccall(1) prologue: pick (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	b, h
	ld	c, l
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	ld	h, b
	ld	l, c
	ex	de, hl
	ld	hl, #3
	or	a, a
	sbc	hl, de
	jr	nz, __xcc_L1
__xcc_L0:
	ld	hl, #1
	ex	de, hl
	jr	__pick_end
__xcc_L1:
	ld	hl, #0
	ex	de, hl
	jr	__pick_end
__xcc_L2:
__pick_end:
	; epilogue: pick
	ld	sp, ix
	pop	ix
	ret
