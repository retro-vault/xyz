	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=2, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	-2(ix), e
	ld	-1(ix), d
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) param y at -2(ix)
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	a, h
	or	a, l
	jr	z, __xcc_L1
__xcc_L0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	de, #5
	add	hl, de
	ld	b, h
	ld	c, l
	ld	-2(ix), l
	ld	-1(ix), h
	jr	__xcc_L2
__xcc_L1:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	de, #5
	add	hl, de
	ld	b, h
	ld	c, l
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, l
	xor	#3
	ld	l, a
	ld	a, h
	xor	#0
	ld	h, a
	ld	b, h
	ld	c, l
	ld	-6(ix), l
	ld	-5(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
