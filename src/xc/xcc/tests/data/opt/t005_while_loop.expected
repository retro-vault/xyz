	.module	xcc_output
	.area	_CODE
	.globl	_sum
_sum:
	; prologue: sum (locals=2)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive param n at 4(ix)
	ld	hl, #0
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L0:
	ld	l, 4(ix)
	ld	h, 5(ix)
	ex	de, hl
	ld	hl, #0
	ex	de, hl
	or	a, a
	sbc	hl, de
	jp	z, __cmp_e_30886
	jp	p, __cmp_t_89383
	ld	hl, #0
	jp	__cmp_e_30886
__cmp_t_89383:
	ld	hl, #1
__cmp_e_30886:
	ld	a, h
	or	a, l
	jp	z, __xcc_L2
__xcc_L1:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	e, 4(ix)
	ld	d, 5(ix)
	add	hl, de
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, 4(ix)
	ld	h, 5(ix)
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, 4(ix)
	ld	h, 5(ix)
	dec	hl
	ld	4(ix), l
	ld	5(ix), h
	jp	__xcc_L0
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
__sum_end:
	; epilogue: sum
	ld	sp, ix
	pop	ix
	ret
