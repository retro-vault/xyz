	.module	xcc_output
	.area	_CODE
	.globl	_sum
_sum:
	; sdcccall(1) prologue: sum (locals=4, temp_frame=10, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	hl, #-14
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param n at -4(ix)
	ld	hl, #0
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_L0:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	ld	hl, #0
	ex	de, hl
	or	a, a
	sbc	hl, de
	ld	hl, #0
	jp	z, __cmp_e_89383
	jp	m, __cmp_e_89383
	inc	l
__cmp_e_89383:
	ld	-6(ix), l
	ld	-5(ix), h
	ld	a, h
	or	a, l
	jp	z, __xcc_L2
__xcc_L1:
	ld	l, -2(ix)
	ld	h, -1(ix)
	push	hl
	ld	e, -4(ix)
	ld	d, -3(ix)
	pop	hl
	add	hl, de
	ld	-8(ix), l
	ld	-7(ix), h
	ld	-2(ix), l
	ld	-1(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-10(ix), l
	ld	-9(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	dec	hl
	ld	-12(ix), l
	ld	-11(ix), h
	ld	-4(ix), l
	ld	-3(ix), h
	jp	__xcc_L0
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-14(ix), l
	ld	-13(ix), h
	ex	de, hl
__sum_end:
	; epilogue: sum
	ld	sp, ix
	pop	ix
	ret
