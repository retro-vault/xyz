	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; O3 sdcc-style leaf fast path: byte seed helper
	ld	c, a
	ld	hl, (#65296)
	ld	a, l
	xor	a, c
	ld	l, a
	ld	e, l
	ld	d, h
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, l
	xor	a, e
	ld	e, a
	ld	a, h
	xor	a, d
	ld	d, a
	ld	a, e
	ld	l, d
	ld	b, #5
__f_seed_shift:
	srl	l
	rr	a
	djnz	__f_seed_shift
	xor	a, e
	ld	e, a
	ld	a, l
	xor	a, d
	ld	d, a
	ld	b, #0
	ld	hl, #49
	add	hl, bc
	add	hl, de
	ld	a, l
	ret
