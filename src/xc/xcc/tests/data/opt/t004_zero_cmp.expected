	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=2, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-6
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param x at -2(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	ex	de, hl
	ld	hl, #0
	or	a, a
	sbc	hl, de
	ld	hl, #1
	jp	nz, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	-4(ix), l
	ld	-3(ix), h
	ld	-6(ix), l
	ld	-5(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
