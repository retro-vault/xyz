	.module	xcc_output
	.area	_CODE
	.globl	_use_plus1_twice
_use_plus1_twice:
	; sdcccall(1) prologue: use_plus1_twice (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	dec	sp
	dec	sp
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	dec	sp
	dec	sp
	ld	-6(ix), l
	ld	-5(ix), h
	dec	sp
	dec	sp
	ld	l, -8(ix)
	ld	h, -7(ix)
	inc	hl
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ld	b, h
	ld	c, l
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	d, b
	ld	e, c
	add	hl, de
	dec	sp
	dec	sp
	ld	-12(ix), l
	ld	-11(ix), h
	ld	b, h
	ld	c, l
	ex	de, hl
__use_plus1_twice_end:
	; epilogue: use_plus1_twice
	ld	sp, ix
	pop	ix
	ret
