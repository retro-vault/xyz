	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=1, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-1
	add	hl, sp
	ld	sp, hl
	xor	a
	ld	-1(ix), a
__xcc_L0:
	ld	a, -1(ix)
	cp	#4
	jr	nc, __xcc_L2
__xcc_L1:
	ld	a, -1(ix)
	add	a, #1
	ld	-1(ix), a
	jr	__xcc_L0
__xcc_L2:
	ld	a, -1(ix)
	ld	l, a
	ld	h, #0
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
