	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t6 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	ld	-2(ix), l
	ld	-1(ix), h
__xcc_inl___xcc_L0_0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, h
	or	a, l
	jr	z, __xcc_inl___xcc_L2_0
__xcc_inl___xcc_L1_0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	dec	hl
	ld	-2(ix), l
	ld	-1(ix), h
	jr	__xcc_inl___xcc_L0_0
__xcc_inl___xcc_L2_0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
