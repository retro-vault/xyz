	.module	xcc_output
	.area	_CODE
	.globl	_dragon_dead_flag_span
_dragon_dead_flag_span:
	; sdcccall(1) prologue: dragon_dead_flag_span (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	h, a
	ld	-1(ix), h
	ld	a, #9
	ld	b, h
	ld	c, l
	sub	#1
__dragon_dead_flag_span_end:
	; epilogue: dragon_dead_flag_span
	ld	sp, ix
	pop	ix
	ret
