	.module	xcc_output
	.area	_DATA
_buf:
	.ds	16
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=10, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; O3 bench-mix-array loop (count=16)
	ld	hl, #4919
	ld	c, #0
__xcc_L0:
	ld	a, c
	cp	#16
	jr	nc, __xcc_L3
__xcc_L1:
	ld	a, #<(buf)
	add	a, c
	ld	e, a
	ld	a, #>(buf)
	adc	a, #0
	ld	d, a
	ld	a, (de)
	ld	d, c
	ld	e, a
	ld	c, l
	ld	b, h
	ld	hl, #40503
	add	hl, de
	ld	a, c
	xor	l
	ld	l, a
	ld	a, b
	xor	h
	ld	b, a
	ld	h, a
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, b
	rrca
	rrca
	rrca
	and	#31
	or	l
	ld	l, a
	ld	a, e
	xor	#74
	ld	c, a
	ld	a, d
	xor	#127
	ld	b, a
	add	hl, bc
	ld	a, d
	inc	a
	ld	c, a
	jr	__xcc_L0
__xcc_L3:
	ld	-3(ix), l
	ld	-2(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
