	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=4, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-10
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	e, -4 (ix)
	ld	d, -3 (ix)
	ld	l, -2 (ix)
	ld	h, -1 (ix)
	or	a, a
	sbc	hl, de
	ld	hl, #1
	jp	m, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	-6(ix), l
	ld	-5(ix), h
	ld	a, h
	or	a, l
	jp	z, __xcc_L1
__xcc_L0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	-8(ix), l
	ld	-7(ix), h
	jp	__xcc_L2
__xcc_L1:
	ld	l, -4(ix)
	ld	h, -3(ix)
	ld	-8(ix), l
	ld	-7(ix), h
__xcc_L2:
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-10(ix), l
	ld	-9(ix), h
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
