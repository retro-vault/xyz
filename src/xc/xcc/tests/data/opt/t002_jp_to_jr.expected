	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; prologue: f (locals=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; receive param a at 4(ix)
	; receive param b at 6(ix)
	ld	e, 6 (ix)
	ld	d, 7 (ix)
	ld	l, 4 (ix)
	ld	h, 5 (ix)
	or	a, a
	sbc	hl, de
	jp	p, __xcc_L1
__xcc_L0:
	ld	l, 4(ix)
	ld	h, 5(ix)
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	jp	__xcc_L2
__xcc_L1:
	ld	l, 6(ix)
	ld	h, 7(ix)
	ld	-4(ix), l
	ld	-3(ix), h
__xcc_L2:
	ld	l, -4(ix)
	ld	h, -3(ix)
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
