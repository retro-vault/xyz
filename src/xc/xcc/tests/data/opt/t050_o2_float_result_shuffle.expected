	.module	xcc_output
	.area	_CODE
	.globl	_addf
_addf:
	; sdcccall(1) prologue: addf (locals=4, temp_frame=8, stack_params=4)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-4(ix), e
	ld	-3(ix), d
	ld	-2(ix), l
	ld	-1(ix), h
	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -4(ix)
	; receive (sdcccall1) param b at 4(ix)
	.globl	__fsadd
	ld	l, 6(ix)
	ld	h, 7(ix)
	push	hl
	ld	l, 4(ix)
	ld	h, 5(ix)
	push	hl
	ld	l, -4(ix)
	ld	h, -3(ix)
	ex	de, hl
	ld	l, -2(ix)
	ld	h, -1(ix)
	call	__fsadd
	pop	bc
	pop	bc
	ld	b, h
	ld	c, l
	ex	de, hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	h, b
	ld	l, c
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -8(ix)
	ld	h, -7(ix)
	ld	-12(ix), l
	ld	-11(ix), h
	ex	de, hl
	ld	l, -10(ix)
	ld	h, -9(ix)
__addf_end:
	; epilogue: addf
	ld	sp, ix
	pop	ix
	ret
