	.module	xcc_output
	.area	_DATA
_prime:
	.ds	128
	.area	_CODE
	.globl	_main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	xor	a
	ld	-4(ix), a
	ld	hl, #_prime
	ld	-3(ix), l
	ld	-2(ix), h
__xcc_L0:
	ld	a, -4(ix)
	cp	#128
	jr	nc, __xcc_L3
__xcc_L1:
	ld	l, -3(ix)
	ld	h, -2(ix)
	ld	a, #1
	ld	(hl), a
__xcc_L2:
	ld	a, -4(ix)
	add	a, #1
	ld	-4(ix), a
	ld	l, -3(ix)
	ld	h, -2(ix)
	inc	hl
	ld	-3(ix), l
	ld	-2(ix), h
	jr	__xcc_L0
__xcc_L3:
	ld	hl, #_prime
	xor	a
	ld	(hl), a
	ld	hl, #_prime
	inc	hl
	ld	(hl), a
	; O3 sieve mark loop
	ld	c, #2
__xcc_L4:
	bit	7, c
	jr	nz, __xcc_L7
__xcc_L5:
	ld	hl, #prime
	ld	b, #0
	add	hl, bc
	ld	a, (hl)
	or	a
	jr	z, __xcc_L6
__xcc_L10:
	ld	a, c
	add	a, a
	ld	e, a
__xcc_L11:
	bit	7, e
	jr	nz, __xcc_L6
__xcc_L12:
	ld	hl, #prime
	ld	d, #0
	add	hl, de
	xor	a
	ld	(hl), a
	ld	a, e
	add	a, c
	ld	e, a
	jr	__xcc_L11
__xcc_L6:
	inc	c
	jr	__xcc_L4
__xcc_L7:
	ld	a, #127
	ld	e, a
	ld	d, #0
	ld	hl, #_prime
	add	hl, de
	ld	a, (hl)
	ld	l, a
	ld	h, #0
	ld	b, h
	ld	c, l
	ex	de, hl
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
