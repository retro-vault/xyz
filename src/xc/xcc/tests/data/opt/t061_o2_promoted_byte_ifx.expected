	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=3, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t4 live in register for first use
	ld	hl, #-3
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	and	#1
	ld	-1(ix), a
	or	a, a
	jr	z, __xcc_L1
__xcc_L0:
	ld	hl, #1
	ld	-3(ix), l
	ld	-2(ix), h
	jr	__xcc_L2
__xcc_L1:
	ld	hl, #0
	ld	-3(ix), l
	ld	-2(ix), h
__xcc_L2:
	ld	l, -3(ix)
	ld	h, -2(ix)
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
