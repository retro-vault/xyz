	.module	xcc_output
	.area	_CODE
	.globl	_use_local_helper
_use_local_helper:
	; sdcccall(1) prologue: use_local_helper (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	dec	sp
	dec	sp
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-6(ix), l
	ld	-5(ix), h
	ld	de, #3
	add	hl, de
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ex	de, hl
__use_local_helper_end:
	; epilogue: use_local_helper
	ld	sp, ix
	pop	ix
	ret
