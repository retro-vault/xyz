	.module	xcc_output
	.area	_CODE
	.globl	_mask_mix
_mask_mix:
	; sdcccall(1) prologue: mask_mix (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	a, l
	and	#240
	ld	l, a
	ld	a, h
	and	#0
	ld	h, a
	ld	a, l
	xor	#52
	ld	l, a
	ld	a, h
	xor	#18
	ld	h, a
	ld	b, h
	ld	c, l
	ex	de, hl
__mask_mix_end:
	; epilogue: mask_mix
	ret
