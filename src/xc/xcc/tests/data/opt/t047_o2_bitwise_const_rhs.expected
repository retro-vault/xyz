	.module	xcc_output
	.area	_CODE
	.globl	_mask_mix
_mask_mix:
	; sdcccall(1) prologue: mask_mix (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t3 live in register for first use
	; receive (sdcccall1) register param handled by prologue
	ld	a, l
	and	#240
	ld	l, a
	ld	a, h
	and	#0
	ld	h, a
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	a, l
	xor	#52
	ld	l, a
	ld	a, h
	xor	#18
	ld	h, a
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	ex	de, hl
__mask_mix_end:
	; epilogue: mask_mix
	ld	sp, ix
	pop	ix
	ret
