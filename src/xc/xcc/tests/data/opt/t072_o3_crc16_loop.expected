	.module	xcc_output
	.area	_DATA
_buf:
	.ds	96
	.area	_CODE
_bench_seed_word:
	; sdcccall(1) prologue: bench_seed_word (locals=0, temp_frame=0, stack_params=0)
	; frameless function: no IX frame needed
	ld	hl, (#65296)
	ld	b, h
	ld	c, l
	ex	de, hl
__bench_seed_word_end:
	; epilogue: bench_seed_word
	ret
_bench_seed_byte:
	; O3 sdcc-style leaf fast path: byte seed helper
	ld	c, a
	push	bc
	call	_bench_seed_word
	pop	bc
	ld	l, c
	ld	a, e
	xor	a, l
	ld	l, a
	ld	h, d
	ld	e, l
	ld	d, h
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, l
	xor	a, e
	ld	e, a
	ld	a, h
	xor	a, d
	ld	d, a
	ld	a, e
	ld	l, d
	ld	b, #5
__bench_seed_byte_seed_shift:
	srl	l
	rr	a
	djnz	__bench_seed_byte_seed_shift
	xor	a, e
	ld	e, a
	ld	a, l
	xor	a, d
	ld	d, a
	ld	b, #0
	ld	hl, #49
	add	hl, bc
	add	hl, de
	ld	a, l
	ret
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=15, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-15
	add	hl, sp
	ld	sp, hl
__xcc_L0:
	ld	a, #75
	.globl	_bench_seed_byte
	call	_bench_seed_byte
	ld	-2(ix), a
	; O3 bench-fill loop (count=96)
	ld	c, a
	ld	b, #0
	ld	hl, #buf
__xcc_L3:
	ld	a, b
	cp	#96
	jr	nc, __xcc_L2
__xcc_L4:
	ld	a, c
	add	a, a
	add	a, a
	add	a, a
	xor	c
	ld	d, a
	srl	a
	srl	a
	srl	a
	srl	a
	srl	a
	xor	d
	add	a, #34
	add	a, b
	ld	c, a
	xor	b
	ld	(hl), a
	inc	b
	inc	hl
	jr	__xcc_L3
__xcc_L2:
	; O3 crc16 loop (count=96)
	call	_bench_seed_word
	push	de
	pop	hl
	ld	a, l
	xor	#33
	ld	l, a
	ld	a, h
	xor	#16
	ld	h, a
	ld	de, #buf
	ld	bc, #buf
	ld	a, c
	add	a, #96
	ld	c, a
	ld	a, b
	adc	a, #0
	ld	b, a
__xcc_L7:
	ld	a, (de)
	xor	h
	ld	h, a
	ld	a, #8
__xcc_L11:
	add	hl, hl
	jr	nc, __xcc_L16
__xcc_L15:
	push	af
	ld	a, l
	xor	#33
	ld	l, a
	ld	a, h
	xor	#16
	ld	h, a
	pop	af
	jr	__xcc_L13
__xcc_L16:
__xcc_L13:
	dec	a
	jr	nz, __xcc_L11
__xcc_L14:
	push	bc
	ld	a, (de)
	ld	b, a
	add	a, #55
	ld	c, a
	ld	a, #158
	adc	a, #0
	xor	h
	ld	h, a
	ld	a, c
	xor	l
	ld	l, a
	ld	c, h
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	a, c
	rrca
	rrca
	rrca
	and	#31
	or	l
	ld	l, a
	ld	a, b
	xor	#74
	ld	c, a
	ld	b, #127
	add	hl, bc
	pop	bc
	inc	de
	ld	a, e
	cp	c
	jr	nz, __xcc_L7
	ld	a, d
	cp	b
	jr	nz, __xcc_L7
__xcc_L10:
	ld	-11(ix), l
	ld	-10(ix), h
	ld	b, h
	ld	c, l
	ex	de, hl
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
