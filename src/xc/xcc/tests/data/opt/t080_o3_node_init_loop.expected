	.module	xcc_output
	.area	_DATA
_nodes:
	.ds	48
_keys:
	.db	0
	.db	1
	.db	2
	.db	3
	.db	4
	.db	5
	.db	6
	.db	7
	.db	8
	.db	9
	.db	10
	.db	11
	.db	12
	.db	13
	.db	14
	.db	15
	.db	16
	.db	17
	.db	18
	.db	19
	.db	20
	.db	21
	.db	22
	.db	23
	.area	_CODE
	.globl	_main
_main:
	; sdcccall(1) prologue: main (locals=0, temp_frame=4, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-4
	add	hl, sp
	ld	sp, hl
	; O3 node init loop (count=24)
	ld	hl, #keys
	ld	de, #nodes
	ld	b, #24
	ld	c, #255
__xcc_L0:
__xcc_L1:
	ld	a, (hl)
	ld	(de), a
	inc	de
	ld	a, c
	ld	(de), a
	inc	de
	inc	hl
	djnz	__xcc_L1
__xcc_L3:
	ld	hl, #_nodes
	inc	hl
	ld	a, (hl)
	ld	l, a
	ld	h, #0
	ld	b, h
	ld	c, l
	ex	de, hl
__main_end:
	; epilogue: main
	ld	sp, ix
	pop	ix
	ret
