	.module	xcc_output
	.area	_DATA
_src:
	.ds	16
_dst:
	.ds	16
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=0, temp_frame=7, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-7
	add	hl, sp
	ld	sp, hl
	xor	a
	ld	-6(ix), a
	ld	hl, #_dst
	ld	-5(ix), l
	ld	-4(ix), h
	ld	hl, #_src
	ld	-3(ix), l
	ld	-2(ix), h
__xcc_L0:
	ld	a, -6(ix)
	cp	#16
	jr	nc, __xcc_L3
__xcc_L1:
	ld	l, -3(ix)
	ld	h, -2(ix)
	ld	a, (hl)
	ld	-1(ix), a
	and	#1
	ld	-7(ix), a
	or	a, a
	jr	z, __xcc_L5
__xcc_L4:
	ld	l, -5(ix)
	ld	h, -4(ix)
	ld	a, -1(ix)
	ld	(hl), a
	jr	__xcc_L2
__xcc_L5:
	ld	a, -1(ix)
	xor	#1
	ld	-7(ix), a
	ld	l, -5(ix)
	ld	h, -4(ix)
	ld	(hl), a
__xcc_L6:
__xcc_L2:
	ld	a, -6(ix)
	add	a, #1
	ld	-6(ix), a
	ld	l, -5(ix)
	ld	h, -4(ix)
	inc	hl
	ld	-5(ix), l
	ld	-4(ix), h
	ld	l, -3(ix)
	ld	h, -2(ix)
	inc	hl
	ld	-3(ix), l
	ld	-2(ix), h
	jr	__xcc_L0
__xcc_L3:
__f_end:
	; epilogue: f
	ld	sp, ix
	pop	ix
	ret
