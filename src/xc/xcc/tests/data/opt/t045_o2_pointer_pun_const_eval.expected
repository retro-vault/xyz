	.module	xcc_output
	.area	_CODE
	.globl	_f
_f:
	; sdcccall(1) prologue: f (locals=6, temp_frame=6, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	hl, #-12
	add	hl, sp
