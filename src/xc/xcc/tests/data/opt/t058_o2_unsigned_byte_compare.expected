	.module	xcc_output
	.area	_CODE
	.globl	_lt_u8
_lt_u8:
	; sdcccall(1) prologue: lt_u8 (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-1(ix), a
	; keep incoming register arg t6 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	cp	l
	; materialize incoming arg temp t6 for later reuse
	ld	-2(ix), l
	jr	nc, __xcc_L2
__xcc_L0:
	ld	a, #1
	jr	__lt_u8_end
__xcc_L2:
	xor	a
__lt_u8_end:
	; epilogue: lt_u8
	ld	sp, ix
	pop	ix
	ret
	.globl	_ge_u8
_ge_u8:
	; sdcccall(1) prologue: ge_u8 (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-1(ix), a
	; keep incoming register arg t10 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	; receive (sdcccall1) register param handled by prologue
	cp	l
	ld	hl, #1
	jr	nc, __cmp_e_89383
	dec	hl
__cmp_e_89383:
	ld	b, h
	ld	c, l
	ex	de, hl
__ge_u8_end:
	; epilogue: ge_u8
	ld	sp, ix
	pop	ix
	ret
