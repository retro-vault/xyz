	.module	xcc_output
	.area	_CODE
_helper:
	; sdcccall(1) prologue: helper (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	; keep incoming register arg t4 live in register for first use
	ex	de, hl
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	ex	de, hl
	; receive (sdcccall1) register param handled by prologue
	; materialize incoming arg temp t4 for later reuse
	ld	-2(ix), l
	ld	-1(ix), h
	ld	a, h
	or	a, l
	jr	z, __xcc_L2
__xcc_L0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	b, h
	ld	c, l
	ex	de, hl
	jr	__helper_end
__xcc_L2:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	de, #2
	add	hl, de
	ld	b, h
	ld	c, l
	ex	de, hl
__helper_end:
	; epilogue: helper
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_branch_helper
_use_branch_helper:
	; sdcccall(1) prologue: use_branch_helper (locals=0, temp_frame=2, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	b, h
	ld	c, l
	ld	hl, #-2
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) register param handled by prologue
	ld	h, b
	ld	l, c
	.globl	_helper
	call	_helper
	push	de
	pop	hl
	ld	b, h
	ld	c, l
	ld	a, l
	xor	#3
	ld	l, a
	ld	a, h
	xor	#0
	ld	h, a
	ld	-2(ix), l
	ld	-1(ix), h
	ex	de, hl
__use_branch_helper_end:
	; epilogue: use_branch_helper
	ld	sp, ix
	pop	ix
	ret
