	.module	xcc_output
	.area	_CODE
	.globl	_use_branch_helper
_use_branch_helper:
	; sdcccall(1) prologue: use_branch_helper (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	dec	sp
	dec	sp
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	a, h
	or	a, l
	jr	z, __xcc_inl___xcc_L2_0
__xcc_inl___xcc_L0_0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	dec	sp
	dec	sp
	ld	-6(ix), l
	ld	-5(ix), h
	jr	__xcc_inl_exit_0
__xcc_inl___xcc_L2_0:
	ld	l, -2(ix)
	ld	h, -1(ix)
	ld	de, #2
	add	hl, de
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-8(ix), l
	ld	-7(ix), h
	ld	-6(ix), l
	ld	-5(ix), h
__xcc_inl_exit_0:
	ld	l, -6(ix)
	ld	h, -5(ix)
	ld	a, l
	xor	#3
	ld	l, a
	ld	a, h
	xor	#0
	ld	h, a
	ld	b, h
	ld	c, l
	dec	sp
	dec	sp
	ld	-10(ix), l
	ld	-9(ix), h
	ex	de, hl
__use_branch_helper_end:
	; epilogue: use_branch_helper
	ld	sp, ix
	pop	ix
	ret
