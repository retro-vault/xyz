	.module	xcc_output
	.area	_CODE
_add1a:
	; sdcccall(1) prologue: add1a (locals=0, temp_frame=0, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	dec	sp
	dec	sp
	ld	-2(ix), l
	ld	-1(ix), h
	; receive (sdcccall1) register param already materialized in prologue
	ld	l, -2(ix)
	ld	h, -1(ix)
	inc	hl
	dec	sp
	dec	sp
	ld	-4(ix), l
	ld	-3(ix), h
	dec	sp
	dec	sp
	ld	-6(ix), l
	ld	-5(ix), h
	ex	de, hl
__add1a_end:
	; epilogue: add1a
	ld	sp, ix
	pop	ix
	ret
	.globl	_use_merge
_use_merge:
	; sdcccall(1) prologue: use_merge (locals=4, temp_frame=8, stack_params=0)
	push	ix
	ld	ix, #0
	add	ix, sp
	ld	-2(ix), l
	ld	-1(ix), h
	ld	-4(ix), e
	ld	-3(ix), d
	ld	hl, #-12
	add	hl, sp
	ld	sp, hl
	; receive (sdcccall1) param a at -2(ix)
	; receive (sdcccall1) param b at -4(ix)
	ld	l, -2(ix)
	ld	h, -1(ix)
	.globl	_add1a
	call	_add1a
	push	de
	pop	hl
	ld	-6(ix), l
	ld	-5(ix), h
	ld	l, -4(ix)
	ld	h, -3(ix)
	.globl	_add1a
	call	_add1a
	push	de
	pop	hl
	ld	-8(ix), l
	ld	-7(ix), h
	ld	l, -6(ix)
	ld	h, -5(ix)
	push	hl
	ld	e, -8(ix)
	ld	d, -7(ix)
	pop	hl
	add	hl, de
	ld	-10(ix), l
	ld	-9(ix), h
	ld	-12(ix), l
	ld	-11(ix), h
	ex	de, hl
__use_merge_end:
	; epilogue: use_merge
	ld	sp, ix
	pop	ix
	ret
