ENTRY _main
FORMAT bin
RANGE 0000-BFFF
AREA _HEADER = 0000
AREA _HEADER_DATA = 0080
AREA _CODE = 0100
AREA _GPX = 4000
AREA _DATA = 5690
AREA _IM2 = 3EFF
AREA _HEAP = 5D00
AREA _P3DOS = B800
AREA _EXTRA = 3F01

# Fixed bank-2 helpers, after +3DOS work RAM and below firmware's BFDF limit.
AREA _KEXT = BF60
