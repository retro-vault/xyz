{
  "compiler": "sdcc",
  "label": "sdcc-z80-ucsim",
  "std_flag": "",
  "artifact_name": "case.ihx",
  "common_flags": [],
  "compile_flags": [
    "-mz80"
  ],
  "compile_template": [
    "{root}/setups/sdcc-z80/bin/sdcc_z80_driver.sh",
